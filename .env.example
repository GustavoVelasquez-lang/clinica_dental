# ============================================================
#  CLINICA SELEDENT - Variables de entorno
#  Copia este archivo como `.env` y completa los valores.
#  NUNCA subas el archivo `.env` real al repositorio.
# ============================================================

# --- Base de datos (Supabase/PostgreSQL) ---
DATABASE_URL="postgresql://usuario:clave@host:puerto/nombre_bd"

# --- Flask ---
SECRET_KEY="genera-clave-aleatoria-aqui"
FLASK_DEBUG=0

# --- OAuth Google (login con Google) ---
GOOGLE_CLIENT_ID="tu-client-id-aqui.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret-aqui"

# --- Google Calendar (sincronizar horarios; opcional) ---
GOOGLE_CALENDAR_ID="primary"
GOOGLE_CALENDAR_CREDENTIALS=""

# --- API consulta DNI (Factiliza) ---
DNI_API_TOKEN="tu-token-de-factiliza-aqui"

# --- Pago Yape (se muestran en la pagina de pago) ---
YAPE_NUMERO=""
YAPE_NOMBRE=""
YAPE_QR="static/img/QR.yape.jpeg"
ADELANTO_MONTO=20.00

# --- WhatsApp (enlaces de contacto/recordatorios) ---
WHATSAPP_NUMERO="51956536766"

# --- Culqi (pago del adelanto: tarjeta + Yape) ---
CULQI_PUBLIC_KEY="pk_test_..."
CULQI_SECRET_KEY="sk_test_..."
CULQI_MONEDA="PEN"
CULQI_API_URL="https://api.culqi.com/v2"

# --- URL publica del sitio (https en produccion) para el webhook de Culqi ---
BASE_URL="http://localhost:5000"

# --- Correo que recibe las notificaciones internas (citas agendadas / pagos) ---
ADMIN_EMAIL=""
