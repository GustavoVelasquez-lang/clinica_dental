# ════════════════════════════════════════════
#  CLÍNICA SELEDENT · Variables de entorno
#  Copia este archivo como `.env` y completa los valores.
#  ⚠️  NUNCA subas el archivo `.env` real al repositorio.
# ════════════════════════════════════════════

# ── Base de datos (Supabase/PostgreSQL) ──
DATABASE_URL="postgresql://usuario:clave@host:puerto/nombre_bd"

# ── OAuth Google (login con Google) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── API consulta DNI (Factiliza) ──
DNI_API_TOKEN=""

# ── Pago Yape (se muestran en la página de pago) ──
YAPE_NUMERO=""
YAPE_NOMBRE=""
YAPE_QR="static/img/qr_yape.jpg"